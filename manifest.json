{
  "manifest_version": 3,
  "name": "Workspace Launcher",
  "version": "0.1",
  "description": "Save groups of open tabs as named workspaces and reopen them all with one click.",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workspace Launcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
